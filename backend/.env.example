ENVIRONMENT=local
DEPLOYMENT_ENVIRONMENT=development
SIGNING_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DATA_DIR=../.local/data
DYNAMODB_TABLE=llm-review-users
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_EC2_METADATA_DISABLED=true
AWS_CONFIG_FILE=/dev/null
AWS_SHARED_CREDENTIALS_FILE=/dev/null
# Explicit host-development override; Python/Helm defaults use the cluster Service.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
# Optional: pin the installed digest. Omit the variable to capture it at startup.
# OLLAMA_MODEL_DIGEST=sha256:...
MODEL_CONTEXT_TOKENS=4096
MODEL_KEEP_ALIVE=5m
MODEL_TEMPERATURE=0.7
MODEL_TOP_P=0.8
MODEL_TOP_K=20
MODEL_MIN_P=0
MODEL_REPEAT_PENALTY=1
MODEL_MAX_INPUT_TOKENS=2048
MODEL_MAX_OUTPUT_TOKENS=512
MODEL_INFERENCE_CONCURRENCY=1
INFERENCE_TIMEOUT_SECONDS=180

# Opt in only for local interface exploration; deployment defaults remain closed.
ENABLE_API_DOCS=false
