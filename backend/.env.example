ENVIRONMENT=local
DEPLOYMENT_ENVIRONMENT=development
SIGNING_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DATA_DIR=../.local/data
DYNAMODB_TABLE=llm-review-users
DYNAMODB_ENDPOINT_URL=http://localhost:8001
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_EC2_METADATA_DISABLED=true
AWS_CONFIG_FILE=/dev/null
AWS_SHARED_CREDENTIALS_FILE=/dev/null
MODEL_ID=Qwen/Qwen3-1.7B
MODEL_REVISION=70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
HF_HOME=../.local/models/huggingface
MODEL_MAX_INPUT_TOKENS=2048
MODEL_MAX_OUTPUT_TOKENS=512
MODEL_INFERENCE_CONCURRENCY=1
MODEL_CPU_THREADS=2
INFERENCE_TIMEOUT_SECONDS=180

# Opt in only for local interface exploration; deployment defaults remain closed.
ENABLE_API_DOCS=false
