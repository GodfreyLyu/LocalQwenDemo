{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "model",
    "persistence",
    "volumePermissions",
    "gpu",
    "resources",
    "startupTimeoutSeconds",
    "verification"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "digest",
        "context",
        "cpuThreads",
        "pullIfMissing",
        "waitSeconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:/-]{1,128}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "context": {
          "type": "integer",
          "minimum": 512,
          "maximum": 8192
        },
        "cpuThreads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "pullIfMissing": {
          "type": "boolean"
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageClass",
        "size",
        "existingClaim"
      ],
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "existingClaim": {
          "type": "string"
        }
      }
    },
    "volumePermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceName"
      ],
      "properties": {
        "resourceName": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+/[a-zA-Z0-9_.-]+$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory",
            "ephemeral-storage"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            },
            "ephemeral-storage": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory",
            "ephemeral-storage"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            },
            "ephemeral-storage": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "startupTimeoutSeconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 7200
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argoPostSync"
      ],
      "properties": {
        "argoPostSync": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#"
}
