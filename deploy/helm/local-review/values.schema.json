{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "inference",
    "frontend",
    "dynamodb",
    "imagePullSecrets",
    "signingSecret",
    "persistence",
    "volumePermissions",
    "model",
    "config",
    "startupTimeoutSeconds",
    "monitoring",
    "networkPolicy"
  ],
  "properties": {
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "resources"
      ],
      "properties": {
        "replicas": {
          "const": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "dynamodb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "table",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "table": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "signingSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageClass",
        "history",
        "dynamodb"
      ],
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "existingClaim"
          ],
          "properties": {
            "size": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "modelCache": {
          "type": "object",
          "deprecated": true,
          "description": "Ignored compatibility input for retained values from older releases; no cache PVC is created or mounted.",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "dynamodb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "existingClaim"
          ],
          "properties": {
            "size": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        }
      }
    },
    "volumePermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedId",
        "expectedRevision",
        "maxOutputTokens",
        "timeoutSeconds"
      ],
      "properties": {
        "expectedId": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 3,
          "maximum": 32768
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOrigin",
        "cookieSecure",
        "enableApiDocs",
        "queueCapacity",
        "maxRetries",
        "sourceMaxChars",
        "sessionTtlSeconds",
        "deploymentEnvironment",
        "releaseSha"
      ],
      "properties": {
        "allowedOrigin": {
          "type": "string"
        },
        "cookieSecure": {
          "type": "boolean"
        },
        "enableApiDocs": {
          "type": "boolean"
        },
        "queueCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "sourceMaxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32000
        },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "deploymentEnvironment": {
          "type": "string",
          "enum": [
            "minikube",
            "development",
            "unknown"
          ]
        },
        "releaseSha": {
          "type": "string",
          "pattern": "^$|^[a-f0-9]{40}$"
        }
      }
    },
    "startupTimeoutSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 7200
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "inferenceNamespace",
        "inferenceRelease"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "inferenceNamespace": {
          "type": "string",
          "minLength": 1
        },
        "inferenceRelease": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "release",
        "intervalSeconds",
        "scrapeTimeoutSeconds",
        "sampleLimit",
        "prometheusPodLabels",
        "alerts",
        "dashboards",
        "ollamaNamespace",
        "ollamaRelease"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "release": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,51}[a-z0-9])?$"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "scrapeTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "sampleLimit": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "prometheusPodLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "minimumCompletedReviews",
            "failureRatio",
            "runbookUrl"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minimumCompletedReviews": {
              "type": "integer",
              "minimum": 5,
              "maximum": 1000
            },
            "failureRatio": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1
            },
            "runbookUrl": {
              "type": "string",
              "pattern": "^https://\\S+$"
            }
          }
        },
        "dashboards": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "ollamaNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "ollamaRelease": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,51}[a-z0-9])?$"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "socketTimeoutSeconds",
        "recoverySeconds"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "socketTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "recoverySeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#"
}
