{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "frontend",
    "dynamodb",
    "imagePullSecrets",
    "signingSecret",
    "persistence",
    "volumePermissions",
    "model",
    "config",
    "startupTimeoutSeconds",
    "networkPolicy"
  ],
  "properties": {
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "resources"
      ],
      "properties": {
        "replicas": {
          "const": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "dynamodb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "table",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "table": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "ephemeral-storage"
              ],
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                },
                "ephemeral-storage": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "signingSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageClass",
        "history",
        "modelCache",
        "dynamodb"
      ],
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "existingClaim"
          ],
          "properties": {
            "size": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "modelCache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "existingClaim"
          ],
          "properties": {
            "size": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "dynamodb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "existingClaim"
          ],
          "properties": {
            "size": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        }
      }
    },
    "volumePermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "ollamaBaseUrl",
        "ollamaModel",
        "ollamaModelDigest",
        "id",
        "revision",
        "dtype",
        "maxInputTokens",
        "maxOutputTokens",
        "cpuThreads",
        "timeoutSeconds"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "ollama",
            "transformers"
          ]
        },
        "ollamaBaseUrl": {
          "type": "string"
        },
        "ollamaModel": {
          "type": "string"
        },
        "ollamaModelDigest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "id": {
          "type": "string",
          "const": "Qwen/Qwen3-1.7B"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dtype": {
          "type": "string",
          "enum": [
            "bfloat16",
            "float32"
          ]
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 128,
          "maximum": 4096
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 3,
          "maximum": 1024
        },
        "cpuThreads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOrigin",
        "cookieSecure",
        "enableApiDocs",
        "queueCapacity",
        "maxRetries",
        "sourceMaxChars",
        "sessionTtlSeconds",
        "deploymentEnvironment",
        "releaseSha"
      ],
      "properties": {
        "allowedOrigin": {
          "type": "string"
        },
        "cookieSecure": {
          "type": "boolean"
        },
        "enableApiDocs": {
          "type": "boolean"
        },
        "queueCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "sourceMaxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32000
        },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "deploymentEnvironment": {
          "type": "string",
          "enum": [
            "minikube",
            "development",
            "unknown"
          ]
        },
        "releaseSha": {
          "type": "string",
          "pattern": "^$|^[a-f0-9]{40}$"
        }
      }
    },
    "startupTimeoutSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 7200
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ollamaHostCidr",
        "ollamaNamespace",
        "ollamaRelease"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ollamaHostCidr": {
          "type": "string",
          "description": "One private IPv4 host /32; required for host Ollama with enabled policies and an empty ollamaNamespace.",
          "pattern": "^$|^(10\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(1[6-9]|2[0-9]|3[01])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))/32$"
        },
        "ollamaNamespace": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "ollamaRelease": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,51}[a-z0-9])?$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#"
}
