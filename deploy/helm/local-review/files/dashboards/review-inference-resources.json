  "panels": [
    {
      "title": "Measurement scope",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Backend and Ollama container resources are separate measurements. GPU utilization is **not measured** by this setup; device allocation does not establish utilization. First-content latency is included in generation duration. Missing token, storage, and timing measurements stay missing."
      },
      "id": 1
    },
    {
      "title": "Section generation duration \u00b7 p95",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, section) (rate(review_generation_duration_seconds_bucket{namespace=\"$namespace\",service=\"review-backend\"}[$__rate_interval]))) and on (section) (sum by (section)(rate(review_generation_duration_seconds_count{namespace=\"$namespace\",service=\"review-backend\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{section}}",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 2
    },
