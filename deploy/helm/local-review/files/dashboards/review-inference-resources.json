    {
      "title": "Application persistent volume usage",
      "type": "timeseries",
      "description": "Used bytes: kubelet volume statistics when available; otherwise Minikube hostPath directory allocation measured by du every 30s. Fallback samples older than 120s are omitted. Requested bytes are the PVC specification, not a filesystem capacity or enforced quota. Retained, unmounted PVCs may also appear. Missing usage is unknown, not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=\"$namespace\"}) or on (namespace, persistentvolumeclaim) (label_replace(max by (claim_namespace, persistentvolumeclaim) (local_hostpath_pvc_used_bytes{claim_namespace=\"$namespace\"} and (time() - local_hostpath_pvc_last_success_timestamp_seconds{claim_namespace=\"$namespace\"} < 120)), \"namespace\", \"$1\", \"claim_namespace\", \"(.+)\") and on (namespace, persistentvolumeclaim) kube_persistentvolumeclaim_info{namespace=\"$namespace\"})",
          "legendFormat": "{{persistentvolumeclaim}} used",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace, persistentvolumeclaim) (kube_persistentvolumeclaim_resource_requests_storage_bytes{namespace=\"$namespace\"})",
          "legendFormat": "{{persistentvolumeclaim}} requested (not quota)",
          "range": true,
          "refId": "B"
        }
      ],
      "id": 12
    },
