      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (increase(review_completions_total{namespace=\"$namespace\",service=\"review-backend\"}[$__rate_interval])) > 0",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 8
    },
