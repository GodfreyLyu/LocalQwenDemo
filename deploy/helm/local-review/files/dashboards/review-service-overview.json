    {
      "title": "HTTP requests by status \u00b7 excluding probes",
      "type": "timeseries",
      "description": "Health probes and metrics scrapes are excluded. Unknown routes still include pre-routing request failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(review_http_requests_total{namespace=\"$namespace\",service=\"review-backend\",route!~\"/health/.*\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "title": "HTTP response duration \u00b7 p95",
      "type": "timeseries",
      "description": "Response-header latency by route, excluding health probes and metrics scrapes. Full body streaming duration is not measured.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(review_http_request_duration_seconds_bucket{namespace=\"$namespace\",service=\"review-backend\",route!~\"/health/.*\"}[$__rate_interval]))) and on (route) (sum by (route)(rate(review_http_request_duration_seconds_count{namespace=\"$namespace\",service=\"review-backend\",route!~\"/health/.*\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "title": "Review outcomes",
      "type": "timeseries",
      "description": "Observed terminal transitions in the rolling rate interval. Counter resets are handled; Prometheus interpolation can produce fractional values.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
